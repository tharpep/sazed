# App
DEBUG=false
# API key: required on all routes except /health. Sazed won't start without it
# unless ALLOW_NO_AUTH=true, which opens every route; use that for local dev only.
API_KEY=
# ALLOW_NO_AUTH=true

# Upstream gateway — all tool calls go through here
GATEWAY_URL=
GATEWAY_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Postgres (Neon)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
