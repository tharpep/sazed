# App
DEBUG=false
# API key (optional): if set, required on all routes except /health
API_KEY=

# Upstream gateway — all tool calls go through here
GATEWAY_URL=
GATEWAY_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Postgres (Neon)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Claude usage ingest key: required as X-Claude-Usage-Key on POST /claude-usage/batch; empty disables it
CLAUDE_USAGE_KEY=
